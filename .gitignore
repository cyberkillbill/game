# Asset meta files are tracked, unless the asset itself is ignored.
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider generated
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Unity crash reports
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
*.idsig

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Android / Gradle ---
.gradle/
local.properties
*.keystore
*.jks

# --- OS / Editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*.swo
*~

# --- Secrets / Cloud ---
*.env
*.env.local
firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# --- Logs ---
*.log
